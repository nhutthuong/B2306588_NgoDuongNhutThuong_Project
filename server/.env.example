NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/QuanLyMuonSach
# JWT Secrets: bắt buộc, tối thiểu 32 ký tự, và phải khác nhau hoàn toàn.
# Cách sinh chuỗi bí mật ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_USER_SECRET=<chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu>
JWT_ADMIN_SECRET=<chuoi-ngau-nhien-khac-toi-thieu-32-ky-tu>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false          # true khi chạy HTTPS (production)
SEED_ADMIN_PASSWORD=<mat-khau-manh>
SEED_DEMO_PASSWORD=<mat-khau-doc-gia-mau>
